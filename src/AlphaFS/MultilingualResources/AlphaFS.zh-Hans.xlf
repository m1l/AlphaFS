<?xml version="1.0" encoding="utf-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en-US" target-language="zh-Hans" original="../ALPHAFS/SRC/ALPHAFS/RESOURCES.RESX">
    <body>
      <group id="../ALPHAFS/SRC/ALPHAFS/RESOURCES.RESX" datatype="resx">
        <trans-unit id="Buffer_Not_Large_Enough" translate="yes" xml:space="preserve">
          <source>Buffer is not large enough for the requested operation.</source>
          <target state="new">缓冲区对于请求的操作来说不够大。</target>
        </trans-unit>
        <trans-unit id="Cannot_Create_Directory" translate="yes" xml:space="preserve">
          <source>Cannot create directory.</source>
          <target state="new">无法创建目录。</target>
        </trans-unit>
        <trans-unit id="Cannot_Determine_Copy_Or_Move" translate="yes" xml:space="preserve">
          <source>Cannot determine Copy or Move action.</source>
          <target state="new">无法确定复制或移动操作。</target>
        </trans-unit>
        <trans-unit id="Destination_Buffer_Not_Large_Enough" translate="yes" xml:space="preserve">
          <source>Destination buffer not large enough for the requested operation.</source>
          <target state="new">目标缓冲区对于请求的操作来说不够大。</target>
        </trans-unit>
        <trans-unit id="Directory_Is_Not_A_MountPoint" translate="yes" xml:space="preserve">
          <source>The directory is not a mount point: [{0}]</source>
          <target state="new">该目录不是装载点：[{0}]</target>
        </trans-unit>
        <trans-unit id="Exception_From_Successful_Operation" translate="yes" xml:space="preserve">
          <source>Incorrectly implemented function attempting to generate exception from successful operation.
</source>
          <target state="new">错误实现的函数试图从成功的操作中生成异常。</target>
        </trans-unit>
        <trans-unit id="File_Is_Hidden" translate="yes" xml:space="preserve">
          <source>The specified file is hidden: [{0}]</source>
          <target state="new">指定的文件已隐藏：[{0}]</target>
        </trans-unit>
        <trans-unit id="File_Or_Directory_Already_Exists" translate="yes" xml:space="preserve">
          <source>The file or directory already exists</source>
          <target state="new">文件或目录已存在</target>
        </trans-unit>
        <trans-unit id="GetCurrentWindowsIdentityFailed" translate="yes" xml:space="preserve">
          <source>Failed to get the current WindowsIdentity.</source>
          <target state="new">无法获取当前的 WindowsIdentity。</target>
        </trans-unit>
        <trans-unit id="GetFullPathOptions_Add_And_Remove_DirectorySeparator_Invalid" translate="yes" xml:space="preserve">
          <source>Cannot add and remove trailing DirectorySeparator simultaneously.</source>
          <target state="new">无法同时添加和删除尾随 DirectorySeparator。</target>
        </trans-unit>
        <trans-unit id="Handle_Is_Closed" translate="yes" xml:space="preserve">
          <source>The handle is closed.</source>
          <target state="new">手柄已关闭。</target>
        </trans-unit>
        <trans-unit id="Handle_Is_Invalid" translate="yes" xml:space="preserve">
          <source>The handle is invalid.</source>
          <target state="new">句柄无效。</target>
        </trans-unit>
        <trans-unit id="Handle_Is_Invalid_Win32Error" translate="yes" xml:space="preserve">
          <source>The handle is invalid. Win32Error: [{0}]</source>
          <target state="new">句柄无效。 Win32错误：[{0}]</target>
        </trans-unit>
        <trans-unit id="HardLinks_Not_Supported" translate="yes" xml:space="preserve">
          <source>Creating hard-links on non-NTFS partitions is not supported.</source>
          <target state="new">不支持在非 NTFS 分区上创建硬链接。</target>
        </trans-unit>
        <trans-unit id="Illegal_Characters_In_Path" translate="yes" xml:space="preserve">
          <source>Illegal characters: [{0}] in path.</source>
          <target state="new">路径中存在非法字符：[{0}]。</target>
        </trans-unit>
        <trans-unit id="InvalidDriveLetterArgument" translate="yes" xml:space="preserve">
          <source>Argument must be a drive letter: "C", RootDir: "C:\" or UNC path: "\\server\share"</source>
          <target state="new">参数必须是驱动器号：“C”、RootDir：“C:\”或 UNC 路径：“\\server\share”</target>
        </trans-unit>
        <trans-unit id="Invalid_File_Attribute" translate="yes" xml:space="preserve">
          <source>An attempt to set an invalid file attribute failed.</source>
          <target state="new">尝试设置无效的文件属性失败。</target>
        </trans-unit>
        <trans-unit id="Invalid_Reparse_Data" translate="yes" xml:space="preserve">
          <source>The data present in the reparse point buffer is invalid</source>
          <target state="new">重分析点缓冲区中存在的数据无效</target>
        </trans-unit>
        <trans-unit id="Invalid_Stream_Name" translate="yes" xml:space="preserve">
          <source>Invalid stream name.</source>
          <target state="new">流名称无效。</target>
        </trans-unit>
        <trans-unit id="Invalid_Subpath" translate="yes" xml:space="preserve">
          <source>Invalid Subpath</source>
          <target state="new">无效的子路径</target>
        </trans-unit>
        <trans-unit id="Invalid_Transaction_Request" translate="yes" xml:space="preserve">
          <source>Invalid transaction request.</source>
          <target state="new">无效的交易请求。</target>
        </trans-unit>
        <trans-unit id="Junction_And_Target_Must_Be_On_The_Same_Drive" translate="yes" xml:space="preserve">
          <source>The target directory of the directory junction must be on the same local drive.</source>
          <target state="new">目录连接的目标目录必须位于同一本地驱动器上。</target>
        </trans-unit>
        <trans-unit id="MoveOptionsDelayUntilReboot_Not_Allowed_With_MoveOptionsCopyAllowed" translate="yes" xml:space="preserve">
          <source>MoveOptions.CopyAllowed is not allowed when using the MoveOptions.DelayUntilReboot flag.</source>
          <target state="new">使用 MoveOptions.DelayUntilReboot 标志时不允许 MoveOptions.CopyAllowed。</target>
        </trans-unit>
        <trans-unit id="MoveOptionsDelayUntilReboot_Not_Allowed_With_NetworkPath" translate="yes" xml:space="preserve">
          <source>MoveOptions.DelayUntilReboot is not allowed when using a network path.</source>
          <target state="new">使用网络路径时不允许 MoveOptions.DelayUntilReboot。</target>
        </trans-unit>
        <trans-unit id="Negative_Count" translate="yes" xml:space="preserve">
          <source>Count cannot be negative.</source>
          <target state="new">计数不能为负数。</target>
        </trans-unit>
        <trans-unit id="Negative_Destination_Offset" translate="yes" xml:space="preserve">
          <source>Destination offset cannot be negative.</source>
          <target state="new">目标偏移量不能为负数。</target>
        </trans-unit>
        <trans-unit id="Negative_Length" translate="yes" xml:space="preserve">
          <source>Length cannot be negative.</source>
          <target state="new">长度不能为负数。</target>
        </trans-unit>
        <trans-unit id="Negative_Lock_Length" translate="yes" xml:space="preserve">
          <source>Lock length cannot be negative.</source>
          <target state="new">锁长度不能为负数。</target>
        </trans-unit>
        <trans-unit id="Negative_Offset" translate="yes" xml:space="preserve">
          <source>Offset cannot be negative.</source>
          <target state="new">偏移量不能为负数。</target>
        </trans-unit>
        <trans-unit id="Network_Path_Not_Allowed" translate="yes" xml:space="preserve">
          <source>Network path is not allowed for directory junction: [{0}]</source>
          <target state="new">目录连接不允许使用网络路径：[{0}]</target>
        </trans-unit>
        <trans-unit id="No_Drive_Letters_Available" translate="yes" xml:space="preserve">
          <source>No drive letters available.</source>
          <target state="new">没有可用的驱动器号。</target>
        </trans-unit>
        <trans-unit id="No_Stream_Seeking_Support" translate="yes" xml:space="preserve">
          <source>This stream does not support seeking.</source>
          <target state="new">该流不支持查找。</target>
        </trans-unit>
        <trans-unit id="Not_A_Valid_Guid" translate="yes" xml:space="preserve">
          <source>Argument is not a valid Volume GUID.</source>
          <target state="new">参数不是有效的卷 GUID。</target>
        </trans-unit>
        <trans-unit id="Path_Is_Zero_Length_Or_Only_White_Space" translate="yes" xml:space="preserve">
          <source>Path is a zero-length string or contains only white space.</source>
          <target state="new">路径是零长度字符串或仅包含空格。</target>
        </trans-unit>
        <trans-unit id="Privilege_Name_Cannot_Be_Empty" translate="yes" xml:space="preserve">
          <source>Privilege name cannot be empty.</source>
          <target state="new">权限名称不能为空。</target>
        </trans-unit>
        <trans-unit id="Read_Incomplete_Header" translate="yes" xml:space="preserve">
          <source>Incomplete header read.</source>
          <target state="new">标题读取不完整。</target>
        </trans-unit>
        <trans-unit id="Returned_Invalid_Security_Descriptor" translate="yes" xml:space="preserve">
          <source>Invalid security descriptor returned from system.</source>
          <target state="new">从系统返回的安全描述符无效。</target>
        </trans-unit>
        <trans-unit id="Source_OffsetAndLength_Outside_Bounds" translate="yes" xml:space="preserve">
          <source>Source offset and length outside the bounds of the array</source>
          <target state="new">源偏移量和长度超出数组范围</target>
        </trans-unit>
        <trans-unit id="Target_Directory_Is_A_File" translate="yes" xml:space="preserve">
          <source>The target directory is a file, not a directory: [{0}]</source>
          <target state="new">目标目录是文件，而不是目录：[{0}]</target>
        </trans-unit>
        <trans-unit id="Target_File_Is_A_Directory" translate="yes" xml:space="preserve">
          <source>The target file is a directory, not a file: [{0}]</source>
          <target state="new">目标文件是目录，而不是文件：[{0}]</target>
        </trans-unit>
        <trans-unit id="Transaction_Already_Aborted" translate="yes" xml:space="preserve">
          <source>Transaction already aborted.</source>
          <target state="new">交易已中止。</target>
        </trans-unit>
        <trans-unit id="Transaction_Already_Committed" translate="yes" xml:space="preserve">
          <source>Transaction already committed.</source>
          <target state="new">交易已提交。</target>
        </trans-unit>
        <trans-unit id="Transaction_Invalid" translate="yes" xml:space="preserve">
          <source>Invalid transaction object.</source>
          <target state="new">交易对象无效。</target>
        </trans-unit>
        <trans-unit id="Transaction_Not_Active" translate="yes" xml:space="preserve">
          <source>Transaction not active.</source>
          <target state="new">交易不活跃。</target>
        </trans-unit>
        <trans-unit id="Transaction_Not_Requested" translate="yes" xml:space="preserve">
          <source>Transaction not requested.</source>
          <target state="new">未请求交易。</target>
        </trans-unit>
        <trans-unit id="Transactional_Conflict" translate="yes" xml:space="preserve">
          <source>Transactional conflict.</source>
          <target state="new">交易冲突。</target>
        </trans-unit>
        <trans-unit id="UNC_Path_Should_Match_Format" translate="yes" xml:space="preserve">
          <source>Network share path should match the format: \\server\share</source>
          <target state="new">网络共享路径应符合格式：\\server\share</target>
        </trans-unit>
        <trans-unit id="Unsupported_Path_Format" translate="yes" xml:space="preserve">
          <source>The given path's format is not supported: [{0}]</source>
          <target state="new">不支持给定路径的格式：[{0}]</target>
        </trans-unit>
      </group>
    </body>
  </file>
</xliff>